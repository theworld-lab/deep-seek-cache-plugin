{
  "name": "dsh-cache-guard",
  "version": "0.1.0",
  "description": "DeepSeek Harness host plugin: context-cache guard — per-session prefix-divergence diagnostics and cache hit-rate projection from normalized usage buckets",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "node --disable-warning=ExperimentalWarning tests/pure-check.ts"
  },
  "files": [
    "lib",
    "src",
    "tests",
    "cordis.patch.yml",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
